#!/usr/bin/env bash
# Blocks pushes to main (work on a branch and open a PR), then validates skills.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    echo "push to main is blocked: use a branch and open a pull request." >&2
    exit 1
  fi
done
"$root/scripts/validate-skills.sh"
